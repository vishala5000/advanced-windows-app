<Window x:Class="MyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Shorts - YouTube Shorts Generator" 
        Height="750" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A0C6E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Auto Shorts" FontSize="32" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="Enter your quotes below. Each line will be converted into a unique, engaging YouTube Short (9:16 format)." 
                       FontSize="14" Foreground="#6C757D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Input Section -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Quotes (One per line):" FontSize="14" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
            
            <TextBox x:Name="txtQuotes" 
                     Grid.Row="1"
                     AcceptsReturn="True" 
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="14"
                     Padding="12"
                     BorderBrush="#CED4DA"
                     BorderThickness="1"
                     Background="White"/>
        </Grid>

        <!-- Controls Section -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15">
            <Button x:Name="btnGenerate" Content="🚀 Generate & Zip Shorts" Style="{StaticResource PrimaryButton}" Click="BtnGenerate_Click"/>
        </StackPanel>

        <!-- Progress & Status Section -->
        <StackPanel Grid.Row="3">
            <ProgressBar x:Name="progressBar" Height="8" Foreground="#0078D7" Background="#E9ECEF" BorderThickness="0" Visibility="Collapsed"/>
            <TextBlock x:Name="txtStatus" Text="Ready. Enter quotes to begin." FontSize="13" Foreground="#6C757D" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
