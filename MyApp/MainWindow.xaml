<Window x:Class="MyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyApp" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Welcome to Advanced Software" 
                   FontSize="28" FontWeight="Bold" Foreground="#333333" 
                   HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Enter your input below:" FontSize="16" Margin="0,0,0,10"/>
            <TextBox Width="300" Height="40" x:Name="InputBox" Margin="0,0,0,20"/>
            <Button Content="Execute Action" Width="200" Height="45" 
                    Click="ExecuteAction_Click" Background="#107C10"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready" 
                   FontSize="14" Foreground="#666666" HorizontalAlignment="Center"/>
    </Grid>
</Window>
